#!/usr/bin/env bash
set -euo pipefail

# One-button Quintessentia CLI launcher (POSIX / WSL 2 ext4)
SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"

if [[ -n "${QUINTESSENTIA_PYTHON:-}" && -x "${QUINTESSENTIA_PYTHON}" ]]; then
    PY="${QUINTESSENTIA_PYTHON}"
elif [[ -x "${HOME}/ai_venv/bin/python" ]]; then
    PY="${HOME}/ai_venv/bin/python"
elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
    PY="${SCRIPT_DIR}/.venv/bin/python"
else
    PY="$(command -v python3 || command -v python)"
fi

exec "$PY" "$SCRIPT_DIR/quintessentia.py" "$@"
